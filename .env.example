# Local development: copy to `.env.local`.
# INNGEST_DEV must be set via env (never hardcoded as isDev: true).
# Bring your own Google OAuth client. Redirect URI: {APP_URL}/api/auth/google/callback
# On Vercel with Deployment Protection, VERCEL_AUTOMATION_BYPASS_SECRET is injected
# when Protection Bypass for Automation is enabled; Connect appends it to the Attio webhook URL.

INNGEST_DEV=1
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/attio_google_calendar
ATTIO_API_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CONNECTION_TIMEZONE=Europe/Stockholm
APP_URL=http://localhost:3000
